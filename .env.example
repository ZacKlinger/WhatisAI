# Firebase web configuration is public, not an Admin SDK or OAuth client secret.
# Leave all four empty to build a usable guest-only site.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional custom-domain build configuration:
# SITE_URL=https://your-domain.example
# SITE_BASE=/
# Optional overrides for the public PostHog project in src/data/analytics.json.
# Set an explicitly empty PUBLIC_POSTHOG_KEY to disable analytics in a local build.
# PUBLIC_POSTHOG_KEY=phc_your_project_token
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local testing only; leave unset in production:
# PUBLIC_POSTHOG_ALLOW_LOCALHOST=true
