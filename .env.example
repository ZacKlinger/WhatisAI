# Firebase web configuration is public, not an Admin SDK or OAuth client secret.
# Leave all four empty to build a usable guest-only site.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional custom-domain build configuration:
# SITE_URL=https://your-domain.example
# SITE_BASE=/
