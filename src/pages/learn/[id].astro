---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getModules, getSignals } from '@/lib/curriculum';
import { trackById } from '@/data/tracks';
import { items } from '@/data/items';
import { mdxComponents } from '@/components/mdx';
import ModuleStatus from '@/components/app/ModuleStatus';
import MasteryCheck from '@/components/quiz/MasteryCheck';
import { moduleUrl, url } from '@/lib/url';

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: modules[i - 1] ?? null, next: modules[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const track = trackById[d.track];
const modules = await getModules();
const titles = Object.fromEntries(modules.map((m) => [m.id, m.data.title]));
const inTrack = modules.filter((m) => m.data.track === d.track);
const position = inTrack.findIndex((m) => m.id === entry.id) + 1;
const signals = (await getSignals()).filter((s) => s.data.modules.includes(entry.id)).slice(0, 4);
const unlocks = modules.filter((m) => m.data.prerequisites.includes(entry.id));
const toc = headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levelLabel = ['', 'Foundational', 'Introductory', 'Intermediate', 'Advanced', 'Frontier'][d.level];
---

<BaseLayout title={d.title} description={d.summary} active="path">
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>

  <header class={`module-hero aura ${track.aura}`}>
    <div class="container-read" style="padding-block: clamp(48px, 8vw, 96px) clamp(36px, 5vw, 56px);">
      <a href={url(`/path/#${track.id}`)} class="eyebrow" style="color:var(--fg)">
        <span>Track {track.numeral} · {track.title}</span><span class="faint">·</span><span class="muted">Module {position} of {inTrack.length}</span>
      </a>
      <h1 style="margin-top:14px">{d.title}</h1>
      <p class="lead" style="margin:16px 0 0;color:var(--fg);opacity:.78">{d.summary}</p>
      <div class="row small" style="margin-top:22px;gap:8px">
        <span class="pill" style="background:color-mix(in srgb,var(--bg) 55%,transparent)">{d.minutes} min</span>
        <span class="pill" style="background:color-mix(in srgb,var(--bg) 55%,transparent)">{levelLabel}</span>
        <span class="pill" style="background:color-mix(in srgb,var(--bg) 55%,transparent)">Updated {d.updated.toISOString().slice(0, 10)}</span>
      </div>
    </div>
  </header>

  <div class="module-grid container">
    <aside class="module-side hide-sm">
      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <div class="xsmall faint" style="margin-bottom:8px;padding-left:12px">On this page</div>
          {toc.map((h) => <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>)}
          <a href="#mastery">Mastery check</a>
        </nav>
      )}
    </aside>

    <article class="module-main">
      <div style="margin-block:28px 8px">
        <ModuleStatus client:load id={entry.id} prerequisites={d.prerequisites} titles={titles} base={base} />
      </div>

      <section class="card card-soft" style="margin-block:24px 40px">
        <h2 class="h4" style="margin-bottom:10px">By the end, you will be able to</h2>
        <ul class="objectives">
          {d.objectives.map((o) => <li>{o}</li>)}
        </ul>
      </section>

      <div class="prose">
        <Content components={mdxComponents} />
      </div>

      {d.keyTerms.length > 0 && (
        <section style="margin-top:64px">
          <h2 class="h3">Key terms</h2>
          <dl class="terms">
            {d.keyTerms.map((t) => (
              <div>
                <dt>{t.term}</dt>
                <dd>{t.def}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {d.sources.length > 0 && (
        <section style="margin-top:56px">
          <h2 class="h3">Primary sources</h2>
          <p class="small muted" style="margin:6px 0 16px">Go to the originals. Every claim above traces to one of these.</p>
          <ol class="sources">
            {d.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="source-title">{s.title}</a>
                <div class="small muted">{s.authors ? `${s.authors} · ` : ''}{s.org} · {s.year}{s.note ? ` · ${s.note}` : ''}</div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {signals.length > 0 && (
        <section style="margin-top:56px">
          <h2 class="h3">In the world now</h2>
          <p class="small muted" style="margin:6px 0 16px">Recent developments the daily watcher linked to this module.</p>
          <div class="grid" style="gap:10px">
            {signals.map((s) => (
              <a class="card hoverable" href={url(`/signals/${s.id}/`)} style="padding:18px 20px">
                <div class="xsmall faint">{s.data.date.toISOString().slice(0, 10)} · {s.data.kind}</div>
                <div style="font-weight:550;margin-top:4px">{s.data.title}</div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section style="margin-top:56px">
        <MasteryCheck client:visible moduleId={entry.id} items={items[entry.id] ?? []} nextHref={next ? moduleUrl(next.id) : undefined} nextTitle={next?.data.title} />
      </section>

      {unlocks.length > 0 && (
        <p class="small muted" style="margin-top:24px">
          This module prepares you for: {unlocks.map((u, i) => <><a class="link" href={moduleUrl(u.id)}>{u.data.title}</a>{i < unlocks.length - 1 ? ', ' : ''}</>)}.
        </p>
      )}

      <nav class="pager" aria-label="Module navigation">
        {prev ? (
          <a href={moduleUrl(prev.id)} class="card hoverable">
            <div class="xsmall faint">← Previous</div>
            <div style="font-weight:550">{prev.data.title}</div>
          </a>
        ) : <span />}
        {next ? (
          <a href={moduleUrl(next.id)} class="card hoverable" style="text-align:right">
            <div class="xsmall faint">Next →</div>
            <div style="font-weight:550">{next.data.title}</div>
          </a>
        ) : <span />}
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .module-hero { border-bottom: 1px solid var(--line); }
  .module-grid { display: grid; grid-template-columns: 220px minmax(0, var(--read)) 1fr; gap: 48px; }
  .module-side { padding-top: 40px; }
  .module-main { min-width: 0; padding-bottom: 40px; }
  @media (max-width: 1100px) { .module-grid { grid-template-columns: minmax(0, 1fr); max-width: calc(var(--read) + 2 * var(--gutter)); } .module-side { display: none; } }
  .objectives { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .objectives li::marker { color: var(--fg-3); }
  .terms { display: grid; gap: 0; margin: 16px 0 0; }
  .terms > div { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .terms dt { font-weight: 600; }
  .terms dd { margin: 0; color: var(--fg-2); }
  @media (max-width: 560px) { .terms > div { grid-template-columns: 1fr; gap: 4px; } }
  .sources { margin: 0; padding-left: 1.3em; display: grid; gap: 14px; }
  .sources li::marker { color: var(--fg-3); font-size: 0.86rem; }
  .source-title { font-weight: 550; text-decoration: underline; text-decoration-color: var(--line-3); text-underline-offset: 3px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; }
  .pager .card { padding: 18px 20px; }
</style>

<script>
  const bar = document.getElementById('read-bar');
  const main = document.querySelector('.module-main') as HTMLElement | null;
  const onScroll = () => {
    if (!bar || !main) return;
    const r = main.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
    bar.style.width = `${p * 100}%`;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'));
  const targets = links.map((a) => document.getElementById(a.dataset.slug!)).filter(Boolean) as HTMLElement[];
  const spy = () => {
    let current = '';
    for (const t of targets) if (t.getBoundingClientRect().top < 140) current = t.id;
    links.forEach((a) => a.classList.toggle('active', a.dataset.slug === current));
  };
  window.addEventListener('scroll', spy, { passive: true });
  spy();
</script>
