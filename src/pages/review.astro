---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReviewQueue from '@/components/app/ReviewQueue';
import { items } from '@/data/items';
import { getModules } from '@/lib/curriculum';

const modules = await getModules();
const titles = Object.fromEntries(modules.map((m) => [m.id, m.data.title]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Review" description="Spaced review: questions from modules you have studied return just before you would forget them." active="review">
  <section class="container" style="padding-top:clamp(48px,8vw,96px)">
    <h1 style="max-width:18ch">Remember it next year, not just next week.</h1>
    <p class="lead" style="margin-top:16px;max-width:52ch">Questions return just before you'd forget them. Ten minutes, a few times a week.</p>
  </section>
  <section class="container section-tight">
    <ReviewQueue client:load bank={items} titles={titles} base={base} />
  </section>
</BaseLayout>
