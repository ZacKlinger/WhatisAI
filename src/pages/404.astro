---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/url';
---
<BaseLayout title="Not found">
  <section class="aura aura-t6" style="min-height:70vh;display:grid;place-items:center">
    <div class="container" style="text-align:center">
      <div class="eyebrow" style="color:var(--fg)">404</div>
      <h1 class="display" style="margin-top:12px">Out of distribution.</h1>
      <p class="lead" style="margin:16px auto 0;max-width:40ch;color:var(--fg);opacity:.8">This page is not in the training data. Perhaps it was never written, or perhaps it moved.</p>
      <a class="btn btn-primary btn-lg" style="margin-top:28px" href={url('/')}>Return home</a>
    </div>
  </section>
</BaseLayout>
