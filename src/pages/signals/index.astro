---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSignals } from '@/lib/curriculum';
import { url } from '@/lib/url';

const signals = await getSignals();
const kinds = ['research', 'model', 'safety', 'policy', 'economy', 'media', 'trend'] as const;
const label: Record<string, string> = { research: 'Research', model: 'Models', safety: 'Safety', policy: 'Policy', economy: 'Economy', media: 'Media', trend: 'Trends' };
const present = kinds.filter((k) => signals.some((s) => s.data.kind === k));
const byMonth = new Map<string, typeof signals>();
for (const s of signals) {
  const key = s.data.date.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  byMonth.set(key, [...(byMonth.get(key) ?? []), s]);
}
---

<BaseLayout title="Signals" description="The developments in AI that actually matter, selected by a daily watcher and linked to the modules that explain them." active="signals">
  <section class="container" style="padding-top:clamp(48px,8vw,96px)">
    <div class="eyebrow">Signals</div>
    <h1 style="margin-top:10px;max-width:16ch">Only what matters, linked to what explains it.</h1>
    <p class="lead" style="margin-top:16px;max-width:62ch">
      Every morning a watcher reads lab announcements, research feeds, regulators, labor data, and notable media. Most mornings it publishes nothing.
      When something significant happens, it writes a signal: what happened, why it matters, and which modules give you the background to read the original.
    </p>
    <div class="row" style="margin-top:20px">
      <a class="btn btn-ghost btn-sm" href={url('/trends/')}>Trend radar</a>
      <a class="btn btn-ghost btn-sm" href={url('/signals.xml')}>RSS feed</a>
      <a class="btn btn-ghost btn-sm" href={url('/method/#watcher')}>How the watcher decides</a>
    </div>
  </section>

  <section class="container section-tight">
    <div class="chip-row" id="kind-filter" role="toolbar" aria-label="Filter signals">
      <button class="chip" type="button" data-kind="all" aria-pressed="true">All</button>
      {present.map((k) => <button class="chip" type="button" data-kind={k} aria-pressed="false">{label[k]}</button>)}
    </div>

    {[...byMonth.entries()].map(([month, list]) => (
      <div class="month" data-month>
        <h2 class="h4 month-label">{month}</h2>
        <div class="grid" style="gap:12px">
          {list.map((s) => (
            <a href={url(`/signals/${s.id}/`)} class="card hoverable signal-row" data-kind={s.data.kind}>
              <div class="sig-meta">
                <span class="xsmall faint mono">{s.data.date.toISOString().slice(5, 10)}</span>
                <span class="pill">{label[s.data.kind]}</span>
                <span class="sig-dots" aria-label={`Significance ${s.data.significance} of 5`}>
                  {[1, 2, 3, 4, 5].map((i) => <span class={i <= s.data.significance ? 'on' : ''} />)}
                </span>
              </div>
              <div>
                <h3 class="h3" style="font-size:1.18rem">{s.data.title}</h3>
                <p class="small muted" style="margin:6px 0 0">{s.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
    {signals.length === 0 && <div class="empty">No signals yet. The watcher publishes only when something significant happens.</div>}
  </section>
</BaseLayout>

<style>
  .month { margin-top: 40px; }
  .month-label { color: var(--fg-2); margin-bottom: 14px; font-weight: 550; }
  .signal-row { display: grid; grid-template-columns: 170px 1fr; gap: 20px; padding: 20px 22px; }
  @media (max-width: 640px) { .signal-row { grid-template-columns: 1fr; gap: 10px; } }
  .sig-meta { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  @media (max-width: 640px) { .sig-meta { flex-direction: row; align-items: center; } }
  .sig-dots { display: inline-flex; gap: 3px; }
  .sig-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--line-2); }
  .sig-dots span.on { background: var(--fg); }
</style>

<script>
  const bar = document.getElementById('kind-filter');
  bar?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const k = b.dataset.kind;
    bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.signal-row').forEach((r) => (r.style.display = k === 'all' || r.dataset.kind === k ? '' : 'none'));
    document.querySelectorAll<HTMLElement>('[data-month]').forEach((m) => {
      const any = Array.from(m.querySelectorAll<HTMLElement>('.signal-row')).some((r) => r.style.display !== 'none');
      m.style.display = any ? '' : 'none';
    });
  });
</script>
