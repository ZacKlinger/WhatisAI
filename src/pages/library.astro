---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LibraryList from '@/components/app/LibraryList';
import { corpus } from '@/data/corpus';
import { getModules } from '@/lib/curriculum';

const modules = await getModules();
const titles = Object.fromEntries(modules.map((m) => [m.id, m.data.title]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Research library" description="The frontier corpus: landmark papers, system cards, frameworks, and policy texts, each linked to the modules that make it readable." active="library">
  <section class="container" style="padding-top:clamp(48px,8vw,96px)">
    <div class="eyebrow">{corpus.length} documents</div>
    <h1 style="margin-top:10px;max-width:18ch">The documents that move the field.</h1>
    <p class="lead" style="margin-top:16px;max-width:52ch">Finish a document's modules and it's ready to read.</p>
  </section>
  <section class="container section-tight">
    <LibraryList client:load docs={corpus} titles={titles} base={base} />
  </section>
</BaseLayout>

<style is:global>
  .lib-filters { display: grid; gap: 12px; }
  .lib-card { display: grid; grid-template-columns: 1fr 240px; gap: 24px; padding: 20px 22px; }
  @media (max-width: 760px) { .lib-card { grid-template-columns: 1fr; gap: 12px; } }
  .lib-main { display: grid; gap: 8px; align-content: start; }
  .lib-title { font-weight: 600; font-size: 1.08rem; letter-spacing: -0.012em; line-height: 1.35; }
  .lib-title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lib-req { display: block; padding: 2px 0; }
  .lib-req::before { content: '○ '; color: var(--fg-3); }
  .lib-req[data-done='true']::before { content: '● '; color: var(--good); }
  .lib-req:hover { color: var(--fg); }
</style>
