---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActivityCalendar from '@/components/app/ActivityCalendar';
import ContinuePanel from '@/components/app/ContinuePanel';
import ZetaTrace from '@/components/interactive/ZetaTrace';
import StoryQuestion from '@/components/app/StoryQuestion';
import { getModules, getSignals } from '@/lib/curriculum';
import { getLearningPlan } from '@/lib/learning-media';
import { journeys } from '@/data/journeys';
import { homeFeature as feature } from '@/data/homeFeature';
import { moduleUrl, url } from '@/lib/url';

const modules = await getModules();
const signals = await getSignals();
const story = signals.find((signal) => signal.id === feature.signal);
const lesson = modules.find((module) => module.id === feature.lesson);
if (!story || !lesson) throw new Error('The homepage feature must link to an existing Signal and lesson.');
if (!feature.question.choices.some((choice) => choice.id === feature.question.answer)) throw new Error('The homepage question must have a valid answer.');
const others = signals.filter((signal) => signal.id !== feature.signal).slice(0, 3);
const planLessons = modules.map(({ id, data }) => ({ id, title: data.title, track: data.track, minutes: data.minutes, sources: getLearningPlan(id).steps.map(s => s.resource) }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const kindLabel: Record<string, string> = { research: 'Research', model: 'Models', policy: 'Policy', economy: 'Work & society', safety: 'AI safety', media: 'In the conversation', trend: 'Trends' };
---

<BaseLayout quiet title="The Riemann hypothesis" description="Trace the zeros behind an AI-assisted mathematical breakthrough, then continue your learning plan.">
  <article class="observatory" id="latest" aria-labelledby="feature-title">
    <div class="observatory-inner">
      <div class="observatory-copy">
        <p class="issue-date">Mathematics <span aria-hidden="true">/</span> <time datetime={story.data.date.toISOString().slice(0, 10)}>{formatDate(story.data.date)}</time></p>
        <h1 id="feature-title">{feature.headline}</h1>
        <p class="observatory-story">{feature.summary}</p>
        <div class="observatory-links"><a class="story-link" href={url(`/signals/${story.id}/`)}>Read the story</a><a href="#your-plan">Your learning plan</a></div>
        <a class="verification-link" href={story.data.sources[0].url}>Read the verification by Lean and Mathlib ↗</a>
      </div>
      <div class="observatory-plot">
        <h2>Tracing the zeros</h2>
        <ZetaTrace client:load />
      </div>
    </div>
  </article>
  <div class="home">
    <section class="home-intro" id="your-plan" aria-labelledby="plan-title">
      <h2 id="plan-title">Your learning plan</h2>
      <ContinuePanel client:load landing base={base} modules={planLessons} />
      <ActivityCalendar client:load base={base} />
    </section>

    <div class="learning-thread">
      <section class="question-section" id="discovery" aria-labelledby="story-question-title">
        <h2 class="section-label" id="story-question-title" tabindex="-1">Try a question</h2>
        <StoryQuestion client:load question={feature.question} />
        <noscript><div class="static-takeaway"><p>The interactive question needs JavaScript. Here’s the idea to take with you.</p><h3>{feature.question.takeaway}</h3><p>{feature.question.explanation}</p><a class="arrow-link" href="#dive-deeper">Explore the idea</a></div></noscript>
      </section>
      <section class="deeper-section" id="dive-deeper" aria-labelledby="deeper-title">
        <span class="section-label">Go deeper</span>
        <h2 id="deeper-title">{feature.lessonHeading}</h2>
        <p>{feature.lessonSummary}</p>
        <div class="deeper-actions"><a class="arrow-link" href={`${moduleUrl(feature.lesson)}#${feature.lessonAnchor}`}>Explore reasoning models</a><span>{lesson.data.minutes} min</span></div>
      </section>
    </div>

    <section class="pathways" id="choose-path" aria-labelledby="pathways-title">
      <div class="section-heading"><h2 id="pathways-title">Follow your curiosity</h2><a class="link small" href={url('/discover/')}>Try an experiment</a></div>
      <div class="intent-grid">{journeys.map((journey) => <a href={url(`/explore/#${journey.id}`)} class="intent-link"><h3>{journey.title}</h3><p>{journey.question}</p></a>)}</div>
    </section>

    <section class="more-stories" aria-labelledby="more-title">
      <div class="section-heading"><h2 id="more-title">More from AI</h2><a class="link small" href={url('/signals/')}>All stories</a></div>
      <div class="stories-list">{others.map((signal) => <a class="story-teaser" href={url(`/signals/${signal.id}/`)}><div><span>{kindLabel[signal.data.kind]}</span><h3>{signal.data.title}</h3></div><time datetime={signal.data.date.toISOString().slice(0, 10)}>{formatDate(signal.data.date)}</time></a>)}</div>
    </section>
  </div>
</BaseLayout>

<style>
  .observatory { color: #f4f1ff; background: radial-gradient(ellipse at 71% 54%, #25213e 0, #11192e 31%, transparent 62%), radial-gradient(ellipse at 8% 8%, #202a46, transparent 57%), #090f20; }
  .observatory-inner { width: min(100% - 2 * var(--gutter), 1080px); margin-inline: auto; display: grid; grid-template-columns: minmax(0, .93fr) minmax(0, 1fr); align-items: center; gap: clamp(30px, 6vw, 88px); padding-block: clamp(38px, 5vw, 80px); }
  .verification-link { display: inline-block; margin-top: 20px; color: #c9c1e1; font-size: .85rem; text-decoration: underline; text-underline-offset: .2em; }
  .issue-date { color: #d1c4e9; display: flex; align-items: center; gap: 10px; font-size: .875rem; margin: 0 0 20px; }
  .observatory h1 { font: 400 clamp(3.1rem, 7vw, 6rem)/.98 var(--font-serif); letter-spacing: -.065em; margin: 0; color: #f9f5ee; }
  .observatory-story { color: #d3daea; font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.6; max-width: 43ch; margin: 24px 0; }
  .observatory-links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
  .observatory-links a { color: #dde7fe; text-decoration: underline; text-underline-offset: 4px; font-size: .95rem; }
  .observatory-links .story-link { color: #12192f; background: #e8defa; text-decoration: none; border-radius: 30px; padding: 10px 19px; font-weight: 550; }
  .observatory-links a:focus-visible { outline: 2px solid #ffdfa8; outline-offset: 4px; }
  .observatory-plot h2 { color: #f6f0ff; font-size: 1.08rem; font-weight: 500; letter-spacing: -.02em; margin-bottom: 4px; }
  #your-plan { scroll-margin-top: var(--nav-h); }
  @media (max-width: 720px) {
    .observatory-inner { grid-template-columns: minmax(0, 1fr); gap: 26px; padding-block: 30px; }
    .observatory h1 { max-width: 15ch; }
    .issue-date { margin-bottom: 12px; }
    .observatory-story { margin-block: 14px; }
    .observatory-plot { width: min(100%, 480px); justify-self: center; }
  }
  .home { width: min(100% - 2 * var(--gutter), 880px); margin-inline: auto; padding-bottom: 20px; }
  .home-intro { padding-block: clamp(36px, 6vw, 72px); }
  .home-intro > h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -.05em; margin: 0 0 28px; }
  .home-intro :global(.plan-card) { overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); border: 1px solid var(--line-2); border-radius: var(--radius-lg); }
  .home-intro :global(.plan-lesson), .home-intro :global(.plan-outline) { padding: clamp(22px, 4vw, 36px); }
  .home-intro :global(.plan-lesson) { background: var(--bg-soft); }
  .home-intro :global(.plan-lesson h2) { font-family: var(--font-serif); font-size: clamp(1.75rem, 3.6vw, 2.5rem); margin-block: 12px 22px; }
  .home-intro :global(.plan-outline) { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 12px; }
  .home-intro :global(.plan-outline progress) { width: 100%; height: 6px; accent-color: var(--fg); }
  .home-intro :global(.plan-outline nav) { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .learning-thread { max-width: 688px; margin-inline: auto; }
  .question-section { padding-block: 48px 36px; }
  .section-label { display: block; font-size: .78rem; color: var(--fg-2); font-weight: 400; letter-spacing: 0; line-height: 1.5; margin-bottom: 20px; }
  #latest, #discovery, #dive-deeper, #choose-path { scroll-margin-top: calc(var(--nav-h) + 24px); }
  .deeper-section { border-top: 1px solid var(--line-2); padding-block: 32px 44px; }
  .deeper-section .section-label { margin-bottom: 12px; }
  .deeper-section h2 { font-size: 1.45rem; font-weight: 500; }
  .deeper-section > p { font-size: .9rem; color: var(--fg-2); line-height: 1.7; max-width: 60ch; margin-block: 14px 20px; }
  .deeper-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; }
  .deeper-actions > a { font-size: .85rem; font-weight: 500; }
  .deeper-actions > span { font-size: .75rem; color: var(--fg-2); }
  .pathways, .more-stories { border-top: 1px solid var(--line-2); padding-block: 36px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
  .section-heading h2 { font-size: 1.25rem; font-weight: 500; }
  .section-heading > a { font-size: .75rem; flex-shrink: 0; }
  .intent-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 40px; }
  .intent-link { display: block; }
  .intent-link h3 { font-size: .9rem; font-weight: 500; }
  .intent-link p { font-size: .8rem; color: var(--fg-2); line-height: 1.6; margin: 7px 0 0; }
  .intent-link:hover h3 { text-decoration: underline; text-underline-offset: 3px; }
  .stories-list { display: grid; gap: 26px; }
  .story-teaser { display: flex; align-items: baseline; justify-content: space-between; gap: 32px; }
  .story-teaser span, .story-teaser time { color: var(--fg-2); font-size: .7rem; }
  .story-teaser time { flex-shrink: 0; }
  .story-teaser h3 { font-size: .9rem; font-weight: 400; line-height: 1.6; margin-top: 6px; max-width: 65ch; }
  .story-teaser:hover h3 { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 680px) {
    .home-intro :global(.plan-card) { grid-template-columns: 1fr; }
    .learning-thread { padding-inline: 8px; }
    .question-section { padding-top: 36px; }
    .intent-grid { gap: 24px; }
    .story-teaser { flex-direction: column; gap: 8px; }
  }
  @media (max-width: 360px) { .intent-grid { grid-template-columns: 1fr; } .section-heading { gap: 14px; } .section-heading h2 { font-size: 1.15rem; } }
</style>
