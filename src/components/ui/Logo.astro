---
// The mark: an aperture. A ring of attention around a point of focus.
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id="wm-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7aa2ff" />
      <stop offset="0.5" stop-color="#c58bff" />
      <stop offset="1" stop-color="#ff9a6b" />
    </linearGradient>
  </defs>
  <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2.4" />
  <circle cx="19.5" cy="12.5" r="5.5" fill="url(#wm-g)" />
</svg>
