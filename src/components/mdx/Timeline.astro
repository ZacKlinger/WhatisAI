---
interface Event { year: string; title: string; text: string; era?: string }
interface Props { events: Event[] }
const { events } = Astro.props;
---
<ol class="timeline not-prose">
  {events.map((e) => (
    <li>
      <span class="tl-year mono">{e.year}</span>
      <span class="tl-dot" aria-hidden="true"></span>
      <div class="tl-body">
        <div class="tl-title">{e.title}</div>
        <div class="tl-text">{e.text}</div>
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline { list-style: none; padding: 0; margin: 2em 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 76px; top: 8px; bottom: 8px; width: 1px; background: var(--line-2); }
  .timeline li { display: grid; grid-template-columns: 62px 28px 1fr; align-items: start; padding: 10px 0; }
  .tl-year { font-size: 0.82rem; color: var(--fg-2); padding-top: 2px; text-align: right; padding-right: 4px; }
  .tl-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--fg); margin: 6px 0 0 10px; box-shadow: 0 0 0 4px var(--bg); position: relative; z-index: 1; }
  .tl-title { font-weight: 600; font-size: 0.98rem; letter-spacing: -0.01em; }
  .tl-text { color: var(--fg-2); font-size: 0.92rem; line-height: 1.55; margin-top: 2px; }
</style>
