---
import '@/styles/global.css';
import Analytics from '@/components/app/Analytics.astro';
import Logo from '@/components/ui/Logo.astro';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** Hide the footer for focused experiences like the placement exam. */
  bare?: boolean;
}

const {
  title,
  description = 'A path to mastery of AI: from first principles to fluently reading frontier research from Anthropic, OpenAI, and the bodies that govern them.',
  active,
  bare = false,
} = Astro.props;

const fullTitle = title ? `${title} · WhatisAI` : 'WhatisAI · A path to mastery of AI';
const nav = [
  { href: '/explore/', label: 'Explore', key: 'explore' },
  { href: '/path/', label: 'Path', key: 'path' },
  { href: '/placement/', label: 'Placement', key: 'placement' },
  { href: '/signals/', label: 'Signals', key: 'signals' },
  { href: '/trends/', label: 'Trends', key: 'trends' },
  { href: '/library/', label: 'Library', key: 'library' },
  { href: '/review/', label: 'Review', key: 'review' },
  { href: '/method/', label: 'Method', key: 'method' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="WhatisAI Signals" href={url('/signals.xml')} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('whatisai:theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav" id="site-nav">
      <div class="container inner">
        <a href={url('/')} class="wordmark nav-bubble" aria-label="WhatisAI home">
          <Logo />
          <span>WhatisAI</span>
        </a>
        <nav class="nav-links nav-bubble" aria-label="Primary">
          {
            nav.map((n) => (
              <a href={url(n.href)} aria-current={active === n.key ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="nav-right nav-bubble">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Change theme" title="Theme">
            <svg class="ico-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path></svg>
            <svg class="ico-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></svg>
            <svg class="ico-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path></svg>
          </button>
          <a href={url('/explore/')} class="btn btn-primary btn-sm nav-cta" id="nav-cta">Start</a>
          <button class="icon-btn nav-menu-btn" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
      <a href={url('/')}>Home</a>
      {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
      <a href={url('/glossary/')}>Glossary</a>
    </nav>

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <footer class="site-footer">
          <div class="container cols">
            <div class="brand">
              <a href={url('/')} class="wordmark">
                <Logo />
                <span>WhatisAI</span>
              </a>
            </div>
            <div>
              <h4>Learn</h4>
              <ul>
                <li><a href={url('/explore/')}>Find your direction</a></li>
                <li><a href={url('/path/')}>The path</a></li>
                <li><a href={url('/placement/')}>Placement exam</a></li>
                <li><a href={url('/review/')}>Review queue</a></li>
                <li><a href={url('/glossary/')}>Glossary</a></li>
              </ul>
            </div>
            <div>
              <h4>The frontier</h4>
              <ul>
                <li><a href={url('/signals/')}>Signals</a></li>
                <li><a href={url('/trends/')}>Trend radar</a></li>
                <li><a href={url('/library/')}>Research library</a></li>
                <li><a href={url('/signals.xml')}>RSS</a></li>
              </ul>
            </div>
            <div>
              <h4>About</h4>
              <ul>
                <li><a href={url('/method/')}>Method</a></li>
                <li><a href={url('/progress/')}>Your progress</a></li>
                <li><a href="https://github.com/ZacKlinger/WhatisAI">Source</a></li>
              </ul>
            </div>
          </div>
        </footer>
      )
    }

    <Analytics />

    <script>
      const root = document.documentElement;
      const KEY = 'whatisai:theme';
      const btn = document.getElementById('theme-toggle');
      const order = ['auto', 'light', 'dark'] as const;
      type Mode = (typeof order)[number];
      const current = (): Mode => (root.dataset.theme as Mode) || 'auto';
      const paint = (m: Mode) => {
        btn?.querySelectorAll('svg').forEach((s) => ((s as SVGElement).style.display = 'none'));
        const icon = btn?.querySelector(`.ico-${m}`) as SVGElement | null;
        if (icon) icon.style.display = 'block';
        btn?.setAttribute('aria-label', `Theme: ${m}. Change theme`);
      };
      paint(current());
      btn?.addEventListener('click', () => {
        const next = order[(order.indexOf(current()) + 1) % order.length];
        if (next === 'auto') delete root.dataset.theme;
        else root.dataset.theme = next;
        try {
          if (next === 'auto') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, next);
        } catch {}
        paint(next);
        window.dispatchEvent(new CustomEvent('themechange'));
      });

      const nav = document.getElementById('site-nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const menuBtn = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = !menu?.classList.contains('open');
        menu?.classList.toggle('open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      try {
        const raw = localStorage.getItem('whatisai:progress:v1');
        const cta = document.getElementById('nav-cta') as HTMLAnchorElement | null;
        if (raw && cta) {
          const s = JSON.parse(raw);
          if (s.lastModule) {
            cta.textContent = 'Continue';
            cta.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/learn/${s.lastModule}/`;
          }
        }
      } catch {}
    </script>
  </body>
</html>
