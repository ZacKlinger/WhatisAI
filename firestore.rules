rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow get, delete: if owner();
      allow list: if false;
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['json', 'version', 'updatedAt'])
        && request.resource.data.keys().hasAll(['json', 'version', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 500000
        && request.resource.data.updatedAt == request.time;
    }
    // Everything else, including user directories and public progress, is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
